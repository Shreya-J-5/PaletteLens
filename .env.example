# PaletteLens Production Environment Variables

# Database
POSTGRES_DB=palettelens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/palettelens

# Broker / Task Queue
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=production-secret-key-change-me

# Processing & Safety Limits
MAX_FILE_SIZE=52428800
MAX_CRAWL_PAGES=20
CRAWL_TIMEOUT=30
MAX_ANALYSIS_COLOURS=40
